# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL=https://your-cloud-run-url.run.app

# Environment Mode
NODE_ENV=production
PORT=3000
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
INTERNAL_JOB_KEY="replace-with-a-long-random-job-key"
PII_REDACTION_ENABLED=true
RETENTION_DAYS=365

# Firebase Admin credentials (use one option in production)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Client configuration (Vite prefix)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps API Key
# Injected at runtime via GOOGLE_MAPS_API_KEY in Cloud Run (or build-time VITE_GOOGLE_MAPS_API_KEY)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# WhatsApp Cloud API & Webhook Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token
META_APP_SECRET=
