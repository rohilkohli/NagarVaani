rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled != true;
    }

    function hasRole(role) {
      return isStaff() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // SUBMISSIONS — public intake remains constrained; operational writes are backend-only.
    match /submissions/{submissionId} {
      allow read: if resource.data.status != 'pending';
      
      // Citizen creation is handled by the backend, which applies validation,
      // idempotency, rate limits, and audit metadata.
      allow create: if false;
      
      // All operational mutations go through the backend Admin SDK.
      allow update: if false;
      
      // No deletes from client
      allow delete: if false;
    }

    // UPVOTES — track per-user upvotes to prevent duplicates
    match /upvotes/{upvoteId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if false;
    }
    
    // Persistent staff profiles. Users can read their own role; only backend manages roles.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Audit records are backend-only and may contain staff identity metadata.
    match /audit_logs/{auditId} {
      allow read, write: if false;
    }

    // Asynchronous AI jobs are backend-only.
    match /ai_jobs/{jobId} {
      allow read, write: if false;
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
