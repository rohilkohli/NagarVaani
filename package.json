{
  "name": "nagarvaani",
  "private": true,
  "version": "1.0.0",
  "description": "Multilingual AI platform that aggregates citizen infrastructure requests across India via voice, text, and messaging apps — classifies with Gemini, surfaces demand hotspots on a geospatial heatmap, and generates AI-ranked priority recommendations for policymakers.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "check:env": "tsx scripts/check-env.ts",
    "check:model": "tsx scripts/check-model.ts",
    "eval": "tsx scripts/eval-classifier.ts",
    "test": "tsx --test lib/env.test.ts lib/priority.test.ts lib/eval.test.ts lib/transcribe.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "deploy": "bash deploy.sh",
    "docker:build": "docker build -t nagarvaani .",
    "docker:run": "docker run -p 3000:3000 --env-file .env nagarvaani",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.10",
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/google-maps": "^9.3.10",
    "@deck.gl/react": "^9.3.10",
    "@google/genai": "^2.4.0",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.12",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
